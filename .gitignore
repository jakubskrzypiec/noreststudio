# --- Materiały źródłowe ---
# PROJECTS/ jest ŚWIADOMIE śledzone (nie ignorowane) — to jest folder, do
# którego klient dokłada nowe realizacje przez GitHub Desktop. CI samo
# przetwarza nowe pliki (npm run media) i publikuje stronę.
# HOME/ (klipy na hero) też jest śledzone: klient dorzuca tam gotowe klipy,
# a CI scala je z istniejącymi (klip do usunięcia: plik "USUN <nazwa klipu>.txt").
# Reszta materiałów źródłowych zostaje lokalna.
/SLIDER PROJECTS/
/IKONKI/
/CZCIONKI/
*.pdf

# --- Node / Next.js ---
node_modules/
.next/
out/
build/
.vercel/
*.tsbuildinfo
next-env.d.ts

# --- Środowisko ---
.env
.env*.local

# --- System ---
.DS_Store
Thumbs.db
*.log


# Lokalna konfiguracja narzedzi (sciezki zalezne od maszyny).
/.claude/

# Wynik `next build` przy output: export.
/out/
