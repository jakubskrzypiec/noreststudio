# --- Materiały źródłowe ---
# PROJECTS/ jest ŚWIADOMIE śledzone (nie ignorowane) — to jest folder, do
# którego klient dokłada nowe realizacje przez GitHub Desktop. CI samo
# przetwarza nowe pliki (npm run media) i publikuje stronę.
# HOME/ (klipy na hero) i reszta zostają lokalne — kuratorskie, nie
# self-service; zoptymalizowane pliki trafiają do repo przez public/.
/HOME/
/SLIDER PROJECTS/
/IKONKI/
/CZCIONKI/
*.pdf

# --- Node / Next.js ---
node_modules/
.next/
out/
build/
.vercel/
*.tsbuildinfo
next-env.d.ts

# --- Środowisko ---
.env
.env*.local

# --- System ---
.DS_Store
Thumbs.db
*.log


# Lokalna konfiguracja narzedzi (sciezki zalezne od maszyny).
/.claude/

# Wynik `next build` przy output: export.
/out/
